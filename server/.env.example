PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/netcradus
CLIENT_URL=http://localhost:5173

# Firebase Administration Credentials
FIREBASE_PROJECT_ID=netcradus-academia
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@netcradus-academia.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx

# Cloudinary Storage Settings (Optional/Future use)
CLOUDINARY_CLOUD_NAME=xxxxxx
CLOUDINARY_API_KEY=xxxxxx
CLOUDINARY_API_SECRET=xxxxxx

# NodeMailer Transactional Mail Configurations
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=xxxxxx
EMAIL_PASS=xxxxxx
EMAIL_FROM=academia@netcradus.com
